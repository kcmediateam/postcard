# Copy to .env.local and fill in. .env.local is gitignored — NEVER commit real keys.
# Phase 1 is frontend-first against a mock data layer, so none of these are required yet.
# They are listed here so the real backend can drop in later (SPEC §8).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (TEST keys only during the entire build)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Lob (TEST keys only)
LOB_API_KEY=
LOB_PUBLISHABLE_KEY=
LOB_WEBHOOK_SECRET=

# App
APP_URL=http://localhost:3000

# Cron auth for /api/cron/send-scheduled (Vercel Cron Bearer token)
CRON_SECRET=

# Which data provider to use: "mock" (default) or "supabase" (not built yet)
NEXT_PUBLIC_DATA_PROVIDER=mock
